# Db2 Intelligence - copy to .env (git-ignored) and fill in locally. Placeholders only.

# IBM Db2 connection (Docker Db2 Community Edition defaults)
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=TESTDB
DB2_USER=db2inst1
DB2_PASSWORD=your_db2_password_here
DB2_SECURITY=false

# Databases the migration runner and the SQL guard may connect to (comma-separated).
# SAMPLE is always refused.
DB2INTEL_MIGRATION_DATABASES=TESTDB
# Hosts the migration runner and the SQL guard may connect to (comma-separated). Remote hosts are refused.
DB2INTEL_MIGRATION_HOSTS=localhost,127.0.0.1,::1

# Embeddings: ollama (local, no API key) | deterministic (offline, used by the tests)
# EMBEDDING_DIM must equal the model output and the VECTOR(768, FLOAT32) columns.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_TIMEOUT_SECONDS=60

# SQL generation: none (disabled) | ollama (local, no API key)
# Generated SQL is only checked by the static SQL guard; it is never executed.
LLM_PROVIDER=none
LLM_MODEL=qwen2.5-coder:7b
# Defaults to OLLAMA_BASE_URL when empty. Must be a local address unless remote use is allowed below.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=120
# true only if prompts (which contain schema descriptions, never row values) may leave this machine
DB2INTEL_LLM_ALLOW_REMOTE=false

# Planned providers, not implemented yet (placeholders only; leave unset)
OPENAI_API_KEY=your_openai_api_key_here
WATSONX_APIKEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# HTTP API (python -m db2intel.api). The host must be a loopback address.
APP_ENV=development
APP_PORT=8000
DB2INTEL_API_HOST=127.0.0.1
# Bearer token for /api/* (at least 16 characters). Required for /api/v1/guard/check: when empty,
# the guard pool is not started and that route answers 503 guard_disabled.
DB2INTEL_API_TOKEN=
# Guard worker stderr: redacted, size-bounded log (relative to this folder; must end in .log,
# which the repository ignores), or "off" to discard it
DB2INTEL_WORKER_LOG=logs/guard-worker.log
# SQL guard worker pool: workers (1-4) and deadlines in seconds
DB2INTEL_GUARD_WORKERS=2
DB2INTEL_CHECK_DEADLINE_SECONDS=60
DB2INTEL_WORKER_STARTUP_SECONDS=60
DB2INTEL_QUEUE_WAIT_SECONDS=2
# Request size limit in bytes and the row cap used by /guard/lint and /ask
DB2INTEL_MAX_BODY_BYTES=65536
DB2INTEL_API_MAX_ROWS=500
